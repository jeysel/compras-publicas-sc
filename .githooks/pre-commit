#!/usr/bin/env bash
# Bloqueia commit de dado operacional sensível (IP, ARN, identity, chave privada)
# em arquivos de documentação. Baseado no incidente das specs 002/003/009.

set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACM -- '*.md' 'CLAUDE.md' || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

FOUND=0

# IPs genéricos/reservados que não identificam infra real (binds de servidor
# local, loopback) — não bloqueiam por si só; ver RFC 5737/6890.
ALLOWED_IPS='^(0\.0\.0\.0|127\.0\.0\.1|255\.255\.255\.255)$'

check_pattern() {
  local label="$1"
  local pattern="$2"
  local allow_pattern="${3:-}"
  local matches
  matches=$(echo "$STAGED" | xargs -I{} grep -HnE "$pattern" "{}" 2>/dev/null || true)

  if [ -n "$allow_pattern" ] && [ -n "$matches" ]; then
    local filtered=""
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      local ips non_allowed
      ips=$(echo "$line" | grep -oE "$pattern" || true)
      non_allowed=$(echo "$ips" | grep -vE "$allow_pattern" || true)
      if [ -n "$non_allowed" ]; then
        filtered="${filtered}${line}"$'\n'
      fi
    done <<< "$matches"
    matches="${filtered%$'\n'}"
  fi

  if [ -n "$matches" ]; then
    echo "❌ Possível $label encontrado:"
    echo "$matches"
    echo ""
    FOUND=1
  fi
}

check_ipv4() {
  local matches
  matches=$(echo "$STAGED" | xargs -I{} grep -HnE '([0-9]{1,3}\.){3}[0-9]{1,3}' "{}" 2>/dev/null || true)

  if [ -z "$matches" ]; then
    return
  fi

  local real_ip_found=0
  local output=""
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    # Conteúdo da linha, depois de "arquivo:numero:"
    local content="${line#*:*:}"

    local candidatos
    candidatos=$(echo "$content" | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}')

    while IFS= read -r candidate; do
      [ -z "$candidate" ] && continue

      # IPs genéricos/reservados (ALLOWED_IPS) não bloqueiam por si só.
      if echo "$candidate" | grep -qE "$ALLOWED_IPS"; then
        continue
      fi

      # Formato monetário BR ("R$ " antes do valor, ou ",XX" de centavos
      # logo depois) descarta o falso positivo mesmo quando os grupos são
      # todos ≤255 por coincidência (ex.: R$ 12.000.000.000,00) — nenhum IP
      # real aparece nesse contexto.
      local prefix="${content%%"$candidate"*}"
      local suffix="${content#*"$candidate"}"
      if echo "$prefix" | grep -qE 'R\$[[:space:]]*$' || echo "$suffix" | grep -qE '^,[0-9]{2}'; then
        continue
      fi

      # Cada octeto precisa estar entre 0 e 255 pra ser um IPv4 válido de
      # verdade — valor monetário brasileiro frequentemente tem grupo de
      # milhar > 255 (ex.: 602, 755), o que já descarta a maioria dos falsos
      # positivos sem precisar olhar contexto.
      local valido=1
      local octetos
      IFS='.' read -ra octetos <<< "$candidate"
      for octeto in "${octetos[@]}"; do
        if [ "$octeto" -gt 255 ] 2>/dev/null; then
          valido=0
          break
        fi
      done

      if [ "$valido" -eq 1 ]; then
        output="${output}${line}"$'\n'
        real_ip_found=1
      fi
    done <<< "$candidatos"
  done <<< "$matches"

  if [ "$real_ip_found" -eq 1 ]; then
    echo "❌ Possível IPv4 (IP de servidor) encontrado:"
    echo "${output%$'\n'}"
    echo ""
    FOUND=1
  fi
}

check_ipv4
check_pattern "ARN / identity AWS"    'arn:aws:|iam::|AKIA[0-9A-Z]{16}'
check_pattern "chave privada"        'BEGIN (RSA |EC )?PRIVATE KEY'

if [ "$FOUND" -eq 1 ]; then
  echo "Commit bloqueado — dado operacional sensível detectado em arquivo de"
  echo "documentação (repo público). Se for falso positivo (ex.: IP de exemplo"
  echo "genérico como 127.0.0.1), revise e use 'git commit --no-verify' com"
  echo "consciência do que está pulando — não como hábito."
  exit 1
fi

exit 0
